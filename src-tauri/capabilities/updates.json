{
  "identifier": "updates",
  "description": "Only the main window may restart itself and open the project pages",
  "windows": ["main"],
  "permissions": [
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/Zaious/smallstocks-tw" },
        { "url": "https://github.com/Zaious/smallstocks-tw/*" },
        { "url": "https://smallstocks.chroniclecore.com/" }
      ]
    }
  ]
}
